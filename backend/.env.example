DEBUG=True
SECRET_KEY=django-insecure-pkps-saas-production-key-change-me-in-prod-2026

# Aiven Cloud Database URL (Uncomment and paste your Aiven URI here)
# DATABASE_URL=postgres://avnadmin:your_password@your-aiven-host.aivencloud.com:28834/defaultdb?sslmode=require

# Local Database Fallback (Used if DATABASE_URL is not set)
USE_SQLITE=True
DB_NAME=pkps_db
DB_USER=pkps_user
DB_PASSWORD=pkps_secure_password_2026
DB_HOST=localhost
DB_PORT=3306

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# JWT & Security
JWT_SECRET=jwt-super-secret-key-pkps-2026
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fast2SMS Configuration (India Instant SMS Gateway)
FAST2SMS_ENABLED=True
FAST2SMS_API_KEY=YOUR_FAST2SMS_API_KEY_HERE
